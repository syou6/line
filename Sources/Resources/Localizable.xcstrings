          }
        }
      }
    },
    "本来のPINとは別の6桁": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6 digits, different from your real PIN"
          }
        }
      }
    },
    "全データを消去しますか？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all data?"
          }
        }
      }
    },
    "消去する": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase"
          }
        }
      }
    },
    "すべての保管庫とメモが完全に削除されます。この操作は取り消せません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All vaults and notes will be permanently deleted. This cannot be undone."
          }
        }
      }
    },
    "おとり保管庫を削除しますか？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete decoy vault?"
          }
        }
      }
    },
    "削除する": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        }
      }
    },
    "PINを変更しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN changed"
          }
        }
      }
    },
    "おとり保管庫を設定しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decoy vault set"
          }
        }
      }
    },
    "おとり保管庫を削除しました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decoy vault deleted"
          }
        }
      }
    },
    "書き出しました。安全な場所に保管してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exported. Keep it somewhere safe."

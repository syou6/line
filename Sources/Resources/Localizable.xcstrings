      }
    },
    "暗号化して書き出す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Encrypted"
          }
        }
      }
    },
    "ファイルを選んで読み込む": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose File to Restore"
          }
        }
      }
    },
    "新しいPIN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New PIN"
          }
        }
      }
    },
    "この保管庫の新しい6桁PIN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New 6-digit PIN for this vault"
          }
        }
      }
    },
    "おとりPIN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

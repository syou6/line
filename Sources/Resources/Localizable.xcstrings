      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm PIN"
          }
        }
      }
    },
    "もう一度同じ6桁を入力してください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-enter the same 6 digits"
          }
        }
      }
    },
    "確認のためもう一度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter again to confirm"
          }
        }
      }
    },
    "PINが一致しませんでした": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PINs did not match"

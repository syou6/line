  "strings": {
    "ロック解除": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock"
          }
        }
      }
    },
    "PINを入力してください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your PIN"
          }
        }
      }
    },
    "PINを作成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a PIN"
          }
        }
      }
    },
    "メモの暗号化に使う6桁のPINを決めてください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a 6-digit PIN to encrypt your notes"
